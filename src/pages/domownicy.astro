---
import EmergencyContactsCard from "@/components/EmergencyContactsCard";
import HouseholdMembersCard from "@/components/HouseholdMembersCard";
import Layout from "@/layouts/Layout.astro";
import PageBackLink from "@/components/PageBackLink.astro";
---

<Layout title="Domownicy i kontakty — W razie W">
  <main class="min-h-screen bg-background px-4 py-6 text-foreground sm:px-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <PageBackLink />
      <h1 class="font-heading mt-4 text-3xl tracking-[-0.015em] sm:text-4xl">Domownicy i kontakty</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Dodaj osoby, które ewakuują się razem z Tobą, i kontakty na wypadek kryzysu. Dane zostają na tym urządzeniu.
      </p>
      <div class="mt-8 space-y-6">
        <div>
          <HouseholdMembersCard client:only="react" />
        </div>
        <div>
          <EmergencyContactsCard client:only="react" />
        </div>
      </div>
    </div>
  </main>
</Layout>
