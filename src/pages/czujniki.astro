---
import SensorCheck from "@/components/SensorCheck";
import Layout from "@/layouts/Layout.astro";
import PageBackLink from "@/components/PageBackLink.astro";
---

<Layout title="Sprawdzenie telefonu — W razie W">
  <main class="min-h-screen bg-background px-4 py-6 text-foreground sm:px-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <PageBackLink />
      <h1 class="font-heading mt-4 text-3xl tracking-[-0.015em] sm:text-4xl">Sprawdzenie telefonu przed kryzysem</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Zrób to teraz, na spokojnie. W kryzysie aplikacja skorzysta z udzielonych zgód, z ostatniej zapisanej pozycji i
        z pobranej mapy.
      </p>
      <div class="mt-8">
        <SensorCheck client:only="react" />
      </div>
    </div>
  </main>
</Layout>
