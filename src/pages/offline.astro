---
import OfflineScreen from "@/components/OfflineScreen";
import PageBackLink from "@/components/PageBackLink.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Praca bez internetu — W razie W">
  <main class="min-h-screen bg-background px-4 py-6 text-foreground sm:px-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <PageBackLink />
      <h1 class="font-heading mt-4 text-3xl tracking-[-0.015em] sm:text-4xl">Praca bez internetu</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Przygotuj teraz to, czego w kryzysie nie pobierzesz: aplikację na urządzeniu i mapę regionu.
      </p>
      <div class="mt-8">
        <OfflineScreen client:only="react" />
      </div>
    </div>
  </main>
</Layout>
