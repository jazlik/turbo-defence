---
import BackpackChecklist from "@/components/BackpackChecklist";
import Layout from "@/layouts/Layout.astro";
import PageBackLink from "@/components/PageBackLink.astro";
---

<Layout title="Plecak ewakuacyjny — W razie W">
  <main class="min-h-screen bg-background px-4 py-6 text-foreground sm:px-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <PageBackLink />
      <h1 class="font-heading mt-4 text-3xl tracking-[-0.015em] sm:text-4xl">Plecak ewakuacyjny</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Lista dopasowana do Twojej rodziny. Odhaczaj, co już spakowane — zostaje na tym urządzeniu.
      </p>
      <div class="mt-8">
        <BackpackChecklist client:only="react" />
      </div>
    </div>
  </main>
</Layout>
