---
import PageBackLink from "@/components/PageBackLink.astro";
import PlaceCard from "@/components/PlaceCard";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Miejsca ewakuacji — W razie W">
  <main class="min-h-screen bg-background px-4 py-6 text-foreground sm:px-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <PageBackLink />
      <h1 class="font-heading mt-4 text-3xl tracking-[-0.015em] sm:text-4xl">Miejsca ewakuacji</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Alarm prowadzi do najbliższego schronu PSP, gdy trasa jest przygotowana. Własny schron jest na wypadek, gdy w
        pobliżu nie ma schronu PSP.
      </p>
      <div class="mt-8 space-y-4">
        <div>
          <PlaceCard
            client:only="react"
            title="Własny schron"
            description="Używany, gdy nie ma przygotowanej trasy do schronu PSP."
          />
        </div>
      </div>
    </div>
  </main>
</Layout>
