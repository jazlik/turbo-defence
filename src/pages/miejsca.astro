---
import PageBackLink from "@/components/PageBackLink.astro";
import PlaceCard from "@/components/PlaceCard";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Miejsca — W razie W">
  <main class="min-h-screen bg-background px-4 py-6 text-foreground sm:px-8 sm:py-12">
    <div class="mx-auto max-w-2xl">
      <PageBackLink />
      <h1 class="font-heading mt-4 text-3xl tracking-[-0.015em] sm:text-4xl">Miejsca</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Prowadzenie idzie po kolei: najpierw miejsce spotkania, a gdy jest niedostępne — miejsce zapasowe. Na końcu
        drogi jest punkt ewakuacji.
      </p>
      <div class="mt-8 space-y-4">
        <div>
          <PlaceCard
            client:only="react"
            kind="meeting"
            title="Miejsce spotkania"
            description="Tu zbiera się rodzina zaraz po alarmie."
            emphasis="primary"
          />
        </div>
        <div>
          <PlaceCard
            client:only="react"
            kind="backup"
            title="Miejsce zapasowe"
            description="Zapasowa zbiórka, gdy miejsce spotkania jest niedostępne."
            emphasis="secondary"
          />
        </div>
        <div>
          <PlaceCard
            client:only="react"
            kind="shelter"
            title="Punkt ewakuacji"
            description="Twój punkt na końcu drogi — używany, gdy nie ma przygotowanej trasy do schronu PSP."
            emphasis="secondary"
          />
        </div>
      </div>
    </div>
  </main>
</Layout>
