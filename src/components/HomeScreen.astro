---
import { CheckCircle2, ChevronRight, Compass, LoaderCircle, TriangleAlert } from "lucide-react";

import EvacuationPointCard from "@/components/EvacuationPointCard";
---

<div class="min-h-screen bg-background px-4 text-foreground sm:px-8">
  <div class="mx-auto flex min-h-screen max-w-2xl flex-col">
    <header class="flex items-center justify-between gap-4 border-b border-border py-4">
      <a
        href="/"
        class="flex min-h-11 shrink-0 items-center gap-3 whitespace-nowrap rounded-md text-base font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        aria-label="W razie W — strona główna"
      >
        <span
          class="flex size-10 items-center justify-center rounded-md bg-primary text-lg font-semibold text-primary-foreground"
          aria-hidden="true"
        >
          W
        </span>
        <span>W razie W</span>
      </a>

      <div class="flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-core-steel-soft px-3 text-sm font-medium text-core-steel-deep">
        <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
        Przygotowanie
      </div>
    </header>

    <main class="flex-1 space-y-6 py-8 sm:py-12">
      <div>
        <h1 class="font-heading text-3xl tracking-[-0.015em] sm:text-4xl">Plan na wypadek ewakuacji</h1>
        <p class="mt-3 text-lg text-muted-foreground">
          Wskaż punkt, do którego idziecie, i sprawdź czujniki telefonu. Plan zostaje na tym urządzeniu.
        </p>
      </div>

      <EvacuationPointCard client:only="react" />

      <a
        href="/czujniki"
        class="flex min-h-11 items-center gap-4 rounded-lg border border-border bg-surface p-6 shadow-sm outline-none hover:bg-secondary-hover focus-visible:ring-[3px] focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        <span
          class="flex size-11 shrink-0 items-center justify-center rounded-full bg-core-steel-soft text-core-steel-deep"
          aria-hidden="true"
        >
          <Compass className="size-5" strokeWidth={2} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block font-medium">Sprawdź czujniki</span>
          <span class="mt-1 block text-sm text-muted-foreground">
            Lokalizacja i kompas — zgody udziel teraz, nie w kryzysie.
          </span>
        </span>
        <ChevronRight className="size-5 shrink-0 text-muted-foreground" strokeWidth={2} aria-hidden="true" />
      </a>

      <div
        data-offline
        data-state="loading"
        role="status"
        aria-live="polite"
        class="flex items-start gap-4 rounded-md border border-border bg-surface p-4"
      >
        <div
          class="flex size-11 shrink-0 items-center justify-center rounded-full bg-core-steel-soft text-primary"
          aria-hidden="true"
        >
          <LoaderCircle
            data-offline-icon="loading"
            className="size-5 animate-spin motion-reduce:animate-none"
            strokeWidth={2}
          />
          <CheckCircle2 data-offline-icon="ready" className="hidden size-5 text-safe" strokeWidth={2} />
          <TriangleAlert
            data-offline-icon="warning"
            className="hidden size-5 text-attention-foreground"
            strokeWidth={2}
          />
        </div>
        <div>
          <p data-offline-title class="font-medium text-foreground">
            Sprawdzam gotowość offline
          </p>
          <p data-offline-status class="mt-1 text-sm text-muted-foreground">
            Podstawowe pliki zostaną zapisane na tym urządzeniu.
          </p>
        </div>
      </div>
    </main>
  </div>
</div>
