---
import AppMark from "@/components/AppMark.astro";
import ReadinessScreen from "@/components/ReadinessScreen";
---

<div class="min-h-screen bg-background px-4 text-foreground sm:px-8">
  <div class="mx-auto flex min-h-screen max-w-2xl flex-col">
    <header class="sticky top-0 z-20 flex h-[4.5rem] items-center justify-between gap-4 border-b border-border bg-background">
      <a
        href="/"
        class="flex min-h-11 shrink-0 items-center gap-3 whitespace-nowrap rounded-md text-base font-semibold outline-none focus-visible:ring-[3px] focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        aria-label="W razie W — strona główna"
      >
        <span
          class="flex size-10 items-center justify-center rounded-md bg-primary text-primary-foreground"
          aria-hidden="true"
        >
          <AppMark class="size-full" />
        </span>
        <span>W razie W</span>
      </a>

      <div class="flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-core-steel-soft px-3 text-sm font-medium text-core-steel-deep">
        <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
        Przygotowanie
      </div>
    </header>

    <main class="flex-1 space-y-6 pb-8 sm:pb-12">
      <div>
        <ReadinessScreen client:only="react" />
      </div>

      <!-- Zostawia miejsce na przyklejony alarm, żeby nie zasłaniał ostatniego bloku. -->
      <div class="h-44" aria-hidden="true"></div>
    </main>
  </div>
</div>
