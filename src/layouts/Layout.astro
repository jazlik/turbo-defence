---
import "../styles/global.css";

interface Props {
  title?: string;
  mode?: "preparation" | "execution";
}

const { title = "W razie W", mode = "preparation" } = Astro.props;
const themeColor = mode === "execution" ? "#0B1117" : "#F1F2F3";
---

<!doctype html>
<html lang="pl" data-mode={mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="W razie W — aplikacja do przygotowania domu na sytuacje kryzysowe, działająca offline."
    />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-title" content="W razie W" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Registration only: whether the shell is ready is read by `useOfflineShell`, which is what the readiness screen
  // and the /offline card show. A failure is flagged on <html> and announced, because it can happen before React mounts.
  if ("serviceWorker" in navigator && import.meta.env.PROD) {
    navigator.serviceWorker.register("/sw.js").catch(() => {
      document.documentElement.dataset.swFailed = "true";
      window.dispatchEvent(new Event("wrw:sw-failed"));
    });
  }
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
