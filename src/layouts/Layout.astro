---
import "../styles/global.css";

interface Props {
  title?: string;
  mode?: "preparation" | "execution";
}

const { title = "W razie W", mode = "preparation" } = Astro.props;
const themeColor = mode === "execution" ? "#0B1117" : "#F1F2F3";
---

<!doctype html>
<html lang="pl" data-mode={mode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="W razie W — aplikacja do przygotowania domu na sytuacje kryzysowe, działająca offline."
    />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-title" content="W razie W" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  type OfflineState = "loading" | "ready" | "warning";

  const statusRoot = document.querySelector<HTMLElement>("[data-offline]");
  const statusTitle = document.querySelector<HTMLElement>("[data-offline-title]");
  const statusText = document.querySelector<HTMLElement>("[data-offline-status]");
  const statusIcons = document.querySelectorAll<HTMLElement>("[data-offline-icon]");

  const setStatus = (state: OfflineState, title: string, text: string) => {
    if (statusRoot) statusRoot.dataset.state = state;
    if (statusTitle) statusTitle.textContent = title;
    if (statusText) statusText.textContent = text;
    statusIcons.forEach((icon) => icon.classList.toggle("hidden", icon.dataset.offlineIcon !== state));
  };

  if (!("serviceWorker" in navigator)) {
    setStatus(
      "warning",
      "Tryb offline jest niedostępny",
      "Użyj aktualnej wersji przeglądarki, aby plan pozostał dostępny bez internetu.",
    );
  } else if (import.meta.env.PROD) {
    setStatus("loading", "Przygotowuję tryb offline", "Zapisuję podstawowe pliki aplikacji na tym urządzeniu…");
    void navigator.serviceWorker
      .register("/sw.js")
      .then(() => navigator.serviceWorker.ready)
      .then(() => {
        setStatus("ready", "Gotowe do pracy offline", "Podstawowe pliki aplikacji są zapisane na tym urządzeniu.");
      })
      .catch(() => {
        setStatus(
          "warning",
          "Nie udało się przygotować trybu offline",
          "Odśwież stronę przy aktywnym połączeniu, aby spróbować ponownie.",
        );
      });
  }
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
