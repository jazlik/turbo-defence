---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "W razie W" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="W razie W — aplikacja do przygotowania domu na sytuacje kryzysowe, działająca offline."
    />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="apple-mobile-web-app-title" content="W razie W" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  const status = document.querySelector("[data-offline-status]");
  const setStatus = (text: string) => {
    if (status) status.textContent = text;
  };

  if (!("serviceWorker" in navigator)) {
    setStatus("Ta przeglądarka nie obsługuje trybu offline");
  } else if (import.meta.env.PROD) {
    setStatus("Przygotowuję tryb offline…");
    void navigator.serviceWorker
      .register("/sw.js")
      .then(() => navigator.serviceWorker.ready)
      .then(() => {
        setStatus("Gotowe do pracy offline");
      })
      .catch(() => {
        setStatus("Nie udało się przygotować trybu offline");
      });
  }
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
